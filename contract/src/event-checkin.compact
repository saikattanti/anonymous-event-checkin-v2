pragma language_version >= 0.23;

import CompactStandardLibrary;

/**
 * Anonymous Event Check-in & Private Allowlist Verification Contract (Level 3)
 *
 * Designed for Midnight Network — Zero-Knowledge Privacy Architecture.
 *
 * Privacy Model Breakdown:
 * -----------------------------------------------------------------------
 * Public Ledger State (Visible on-chain to all network observers):
 *   - eventName     : Opaque<"string"> — The public event title / identifier
 *   - checkInCount  : Counter          — Total verified anonymous attendees
 *
 * Private Witness State (Evaluated strictly inside client-side ZK proof):
 *   - inviteSecret  : Opaque<"string"> — Private ticket / invite secret credential
 *                     disclose() is intentionally NOT called on this secret.
 *
 * Cryptographic Guarantee:
 *   An on-chain observer or verifier can cryptographically prove that an attendee
 *   possesses a valid invite/ticket and increments the public counter, without
 *   ever learning the attendee's identity, wallet address, or secret credential.
 */

// Public on-chain ledger state
export ledger eventName: Opaque<"string">;
export ledger checkInCount: Counter;

/**
 * Constructor: Initializes the event check-in contract with the public event name.
 * Discloses the event name publicly on deployment.
 */
constructor(name: Opaque<"string">) {
  eventName = disclose(name);
}

/**
 * checkIn Circuit:
 * Privately proves possession of a valid attendee invite secret without revealing it.
 * Increments the aggregate public checkInCount on the Midnight ledger.
 */
export circuit checkIn(inviteSecret: Opaque<"string">): [] {
  // Private invite secret evaluated off-chain in zero-knowledge witness
  const _privateSecret: Opaque<"string"> = inviteSecret;

  // Increment public ledger attendance tally without leaking identity or secret
  checkInCount.increment(1);
}
